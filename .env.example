# Copy to .env, or run ./bin/gen-secrets.sh to generate real throwaway values.
# The example values below are NON-FUNCTIONAL placeholders — the worker keys must
# be base64 of a real RSA PEM pair (Lightning base64-decodes them). Prefer
# gen-secrets.sh.

# Image tags under test.
LIGHTNING_TAG=latest
WORKER_TAG=latest

# Phoenix + Cloak. Any base64 string of sufficient length works for tests.
SECRET_KEY_BASE=REPLACE_ME_base64_48_bytes
PRIMARY_ENCRYPTION_KEY=REPLACE_ME_base64_32_bytes

# Shared symmetric secret for the Worker Token (must match on both services).
WORKER_SECRET=REPLACE_ME_base64_32_bytes

# Run-token keypair: Lightning signs with the private key, the worker verifies
# with the public key. Both are base64(PEM).
WORKER_RUNS_PRIVATE_KEY=REPLACE_ME_base64_of_rsa_private_pem
WORKER_LIGHTNING_PUBLIC_KEY=REPLACE_ME_base64_of_rsa_public_pem
